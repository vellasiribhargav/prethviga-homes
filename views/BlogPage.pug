doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title #{blog.blog_title}
  link(rel='stylesheet' href=utils.assetPath("/bundle/BlogPage.css"))
include layout/header.pug
body
  if blog
    - var bannerUrl = blog.inner_img || (bannerData && bannerData.length > 0 ? bannerData[0].image : '/assets/images/blog1.webp')
    - var bannerStyle = `background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('${bannerUrl}') center/cover no-repeat;`
    header.Blog-hero(style=bannerStyle)
      .Hero-content
        button.Badge #{blog.badge_text || 'Innovation'}
        h1.Title #{blog.blog_title || 'Innovative Materials Revolutionizing Modern Construction'}
        .Meta-data
          span.Author Prethviga Homes Team
          span.dot
          span.Date #{blog.blog_date ? new Date(blog.blog_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'January 28, 2026'}
          span.dot
          span.ReadTime #{blog.timeToRead || '5'} min read
    main.Blog-container
      article.Blog-article
        .blog-rich-content!= blog.blog_content
        //- .Action-Area
          .backBtn
            span
              svg(width='7' height='12' viewbox='0 0 7 12' fill='none' xmlns='http://www.w3.org/2000/svg')
                path(d='M6 11L1 6L6 1' stroke='#C1834E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            button
              a(href="/discoverUs") Back to Blog
          .ShareContainer
            span.shareText Share
            .Icon-container
                a(href="https://x.com/" target="_blank")
                    span
                        svg(width='20' height='17' viewbox='0 0 20 17' fill='none' xmlns='http://www.w3.org/2000/svg')
