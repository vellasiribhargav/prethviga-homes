doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    - var pageSlug = query?.slug || 'home'
    - 
       const titleMap = {
         'home': 'Home',
         'project': 'Project',
         'discoverUs': 'Discover Us',
       }
       const displayTitle = titleMap[pageSlug] || (pageSlug.charAt(0).toUpperCase() + pageSlug.slice(1))
    title #{displayTitle} Banner Management
    link(rel='stylesheet' href=utils.assetPath("/bundle/banner.css"))

  body
    - var activeLink = 'banner'
    
    include ../layout/sidebar.pug

    // Main Page Content
    .main-container.with-sidebar(class='banner-' + pageSlug)
      // Top App Bar
      header.app-header
        .header-left
          button.menu-btn
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='24' viewBox='0 -960 960 960' width='24' fill='#000')
              path(d='M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z')
          h1.page-title #{displayTitle} Banner Management

      // Breadcrumbs
      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item Content Management
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item.active #{displayTitle} Banner Management

      main.main-content
        // Content Header
        .content-header(style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px;")
          .header-title-group(style="display: flex; flex-direction: column; gap: 10px;")
            h2.content-title #{displayTitle} Banner Management
            select#banner-slug-selector.form-select
               option(value="home" selected=pageSlug === 'home') Home
               option(value="project" selected=pageSlug === 'project') Project
               option(value="discoverUs" selected=pageSlug === 'discoverUs') Discover Us
               //-  option(value="ongoing" selected=pageSlug === 'ongoing') On Going
          
          .header-actions
            button.back-btn(onclick=`window.location.href='/admin/banner/${pageSlug}/list'`) List
            button.add-image-btn.add-more-btn Add More
        
        // Section Selection Tabs
        .section-tabs
          button.tab-btn.active(data-section="banner-images") Banner Images
          button.tab-btn(data-section="banner-text") Banner Text Content
          if pageSlug === 'home'
            button.tab-btn(data-section="banner-reviews") Banner Reviews
        
        if pageSlug === 'home'
          .reviews-header-actions(style="margin-bottom: 20px; display: none;")
            button.add-review-btn(type="button")
              svg(width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                line(x1='12' y1='5' x2='12' y2='19')
                line(x1='5' y1='12' x2='19' y2='12')
              span Add Review
        

        // Form Container
        .form-container
          // Banner Text Content Section
          .section-form#section-banner-text
            .content-card
              .form-section
                h3.section-subtitle Banner Text Content
                .form-group
                  label.form-label Heading
                  input#banner-heading.form-input(type="text" name="Heading" placeholder="Enter banner heading")
              
                if pageSlug === 'home'
                  .form-group
                    label.form-label Sub Heading
                    input#banner-subheading.form-input(type="text" name="subHeading" placeholder="Enter banner sub heading")
                
                .form-group
                  label.form-label Description
                  textarea#banner-description.form-input(name="description" rows="4" placeholder="Enter banner description" style="height: auto; padding-top: 12px;" maxlength="400")
                  .char-limit-msg * Characters are more than 400
                
                if pageSlug !== 'discoverUs'
                  .form-group
                    label.form-label Contact Number
                    input#banner-number.form-input(type="text" name="number" placeholder="Enter contact number")
                  
                .submit-section
                  button.submit-btn.save-text-btn Save

          // Banner Images Section
          .section-form#section-banner-images.active
            .content-card
              .form-section
                h3.section-subtitle Banner Images
                .form-group
                  label.form-label Banner Images
                  .image-upload-grid
                    .image-upload-slot
                      button.upload-btn(type="button")
                        .upload-icon
                          svg.icon(xmlns='http://www.w3.org/2000/svg' height='50' viewBox='0 -960 960 960' width='50' fill='#9e6520')
                            path(d='M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71t-71 29ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H638l-73-80H395l-73 80H160v480Zm320-240Z')
                        p.upload-text Upload Image
                        p.upload-subtext JPG, PNG (max. 2MB)
                      input.image-upload(type='file' accept='image/*' style='display: none;' multiple)

                .submit-section
                  button.submit-btn.upload-images-btn Save

          // Banner Reviews Section
          if pageSlug === 'home'
            .section-form#section-banner-reviews
              .content-card
                .form-section
                  h3.section-subtitle Home Reviews (CEO/CFO Quotes)
                  .reviews-container#reviews-container
                  
                  .submit-section(style="margin-top: 20px; text-align: right;")
                    button.submit-btn.save-reviews-btn Save


    input#page_slug(type='hidden' value=pageSlug)
    script(src=utils.assetPath("/bundle/banner.js"))