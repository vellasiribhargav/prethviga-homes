doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    - var pageSlug = query?.slug || 'home'
    - var pageSection = query?.section || 'blogs-card'
    
    - 
       const titleMap = {
         'home': 'Home',
         'project': 'Project',
         'discoverUs': 'Discover Us',
         'ongoing': 'On Going'
       }
       const displayTitle = titleMap[pageSlug] || (pageSlug.charAt(0).toUpperCase() + pageSlug.slice(1))

    title #{displayTitle} Blog Management
    link(rel='stylesheet' href=utils.assetPath("/bundle/blogDiscover.css"))

  body
    - var activeLink = pageSlug + '-blog'
    include ../layout/sidebar.pug

    // Main Page Content
    .main-container.with-sidebar
      // Top App Bar
      header.app-header
        .header-left
          button.menu-btn
            span.material-symbols-outlined menu
          h1.page-title #{displayTitle} Blog Management
        button.notification-btn
          span.material-symbols-outlined notifications

      // Breadcrumbs
      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes
          span.material-symbols-outlined
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
              path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item Content Management
          span.material-symbols-outlined
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
              path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item.active #{displayTitle} Blog Management

      main.main-content
        // Content Header
        .content-header(style="display: flex; flex-direction: column; align-items: flex-start; gap: 15px;")
          h2.content-title #{displayTitle} Blog Management
          
          .selectors-container(style="display: flex; gap: 15px; width: 100%;")
            select#blog-slug-selector.form-select(style="flex: 1;")
               option(value="home" selected=pageSlug === 'home') Home
               option(value="project" selected=pageSlug === 'project') Project
               option(value="discoverUs" selected=pageSlug === 'discoverUs') Discover Us
               option(value="ongoing" selected=pageSlug === 'ongoing') On Going
          
          button.add-more-btn Add More
        
        // Form Container
        .form-container
          .content-card
            .form-header
              span.form-number 1
            .form-section
              // Blog Tag
              .form-group
                label.form-label Blog Tag
                input.form-input(type='text' placeholder='e.g. About Us, Company, Team')
              
              // Blog Cover Image
              .form-group
                label.form-label Blog Cover Image
                button.upload-btn
                  .upload-icon
                    span.material-symbols-outlined 
                        svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24', fill='currentColor')
                            path(d='M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71t-71 29ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H638l-73-80H395l-73 80H160v480Zm320-240Z')
                  p.upload-text Tap to upload cover image
                  p.upload-subtext JPG, PNG (max. 2MB)
                input.image-upload(type='file' accept='image/*' style='display: none;')
              
              // Publication Date
              .form-group
                label.form-label Publication Date
                input.form-input(type='date' name='publication-date')
              
              // Blog Title
              .form-group
                label.form-label Blog Title
                input.form-input(type='text' placeholder='e.g. Discover Our Story and Mission')
              
              // Blog Description
              .form-group
                label.form-label Blog Description
                textarea.form-textarea(placeholder='Write your discover us blog content here...')
            
            // Submit Button
            .submit-section
              button.submit-btn Submit
            
            // Navigation buttons
            .navigation-buttons
              button.nav-btn.prev-btn(disabled) Previous
              button.nav-btn.next-btn Next
        
        // Added Items Section
        .added-items-section(style='display: none;')
          h3.section-title Added Blog Posts
          .added-items-list

    input#page_slug(type='hidden' value=pageSlug)
    input#page_section(type='hidden' value=pageSection)
    script(src=utils.assetPath("/bundle/blogDiscover.js"))
