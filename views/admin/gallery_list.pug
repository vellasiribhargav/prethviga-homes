doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Gallery Inventory
    link(rel='stylesheet' href=utils.assetPath("/bundle/gallery_list.css"))
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")

  body
    - var activeLink = 'gallery'
    include ../layout/list_sidebar.pug
    
    // Main Page Content
    .main-container.with-sidebar
      // Top App Bar
      header.app-header
        .header-left
          button.menu-btn
            i.fas.fa-bars
          h1.page-title Gallery List
        //- .header-right
        //-   button.icon-action-btn
        //-     i.fas.fa-bell
        //-   button.icon-action-btn(style="background: var(--primary); color: white;")
        //-     | V

      // Breadcrumbs
      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes
          span.breadcrumb-separator 
            i.fas.fa-chevron-right
          span.breadcrumb-item Content Management
          span.breadcrumb-separator 
            i.fas.fa-chevron-right
          span.breadcrumb-item.active Gallery List

      main.main-content
        .content-header
          h2.content-title Gallery Inventory
          button#addBtn.add-more-btn(onclick="window.location.href='/admin/gallery'")
            i.fas.fa-plus
            |  Add Gallery Item

        //- // Search and Filter Row
        //- .search-filter-row
        //-   .search-container
        //-     i.fas.fa-search.search-icon
        //-     input.search-input(type="text" placeholder="Search gallery by project, title...")
        //-   select.filter-select
        //-     option All Types
        //-     option Residential
        //-     option Commercial
        //-   button.action-icon-btn
        //-     i.fas.fa-sliders-h

        .table-card
          .table-wrapper
            table.data-table
              thead
                tr
                  th S.NO.
                  th TYPE
                  th PREVIEW
                  th PROJECT NAME
                  th TITLE
                  th DESCRIPTION
                  th ACTIONS
              tbody
                if galleryItems && galleryItems.length > 0
                  each item, idx in galleryItems
                     tr(data-id=item.id data-index=item.index) 
                       td #{String(idx + 1).padStart(2, '0')}
                       td
                         span.status-badge.badge-upcoming #{item.type}
                       td
                         if item.coverImage
                           button.btn-preview(data-image=item.coverImage)
                             i.fas.fa-eye
                             span Preview
                         else
                           span No Image
                       td.item-name-cell #{item.projectName}
                       td #{item.title}
                       td #{item.text || 'No description available...'}
                       td
                         .action-buttons
                           button.icon-action-btn.edit-btn(title="Edit" data-index=item.index data-gallery=JSON.stringify(item))
                             i.fas.fa-pen
                           button.icon-action-btn.delete-btn.delete(title="Delete" data-index=item.index)
                             i.fas.fa-trash-alt
                else
                   tr
                     td(colspan="7" style="text-align:center; padding: 2rem;") No gallery items found.
          
          // Table Footer / Pagination
          .table-footer
            .footer-info
              span Showing 1 to #{galleryItems ? galleryItems.length : 0} of #{galleryItems ? galleryItems.length : 0} items
            .pagination
              button.page-btn(disabled)
                i.fas.fa-chevron-left
              button.page-btn.active 1
              button.page-btn 2
              button.page-btn 3
              button.page-btn
                i.fas.fa-chevron-right

    // Modal for Editing
    #itemModal.modal
            .modal-content
              .modal-header
                h3#modalTitle Edit Gallery Item
                button.close-modal
                  i.fas.fa-times

              form#itemForm(enctype="multipart/form-data" novalidate)
                input(type="hidden", name="index")
                
                .form-grid
                  .form-group.full-width
                    label Type of Project
                    select.form-select(name="projectType")
                      option(value="upcoming") Upcoming Projects
                      option(value="completed") Completed Projects

                  .form-group.full-width
                    label Project Name
                    input.form-input(type="text", name="projectName")

                  .form-group
                    label Gallery Name
                    input.form-input(type="text", name="title")

                  .form-group.full-width
                    label Image Description
                    textarea.form-textarea(name="text", rows="3")

                  .form-group.full-width
                    label Upload Images
                    .file-input-wrapper
                      input(type="file", name="file", accept="image/*")
                      button(type="button" style="display:none").view-current-image-btn
                        i.fas.fa-image
                        |  View Current Image

                .modal-footer
                  button(type="button").btn.btn-secondary.close-modal Cancel
                  button(type="submit").btn.btn-primary Save Changes

    // Modal for Preview
    #previewModal.modal
      .modal-content.preview-modal-content
        .modal-header
          h3 Gallery Preview
          button.close-modal
            i.fas.fa-times
        .preview-container
          img#previewImage(src="", alt="Preview")

    script.
      const PAGE_TYPE = 'gallery-list';
    script(src=utils.assetPath("/bundle/gallery_list.js"))
