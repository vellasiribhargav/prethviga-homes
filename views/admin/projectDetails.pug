doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Project Details Management
    link(rel='stylesheet' href=utils.assetPath("/bundle/projectDetails.css"))
      
  body
    - var activeLink = 'projectDetails'
    include ../layout/sidebar.pug

    .main-container.with-sidebar
      header.app-header
        .header-left
          button.menu-btn
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='24' viewBox='0 -960 960 960' width='24' fill='currentColor')
              path(d='M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z')
          h1.page-title Project Details Management

      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes 
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item Content Management 
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item.active Project Details

      main.main-content
        .content-header
          h2.content-title Manage Project Sections
          .header-actions
            button.back-btn(onclick="window.location.href='/admin/projectDetails/list'") Back to List

        .form-container
          .content-card
            // Project Selection (Outside the specific section forms)
            .form-section
              .form-grid
                .form-group
                  label.form-label Type of Project
                  select.form-select#projectType
                    option(value='' disabled selected) Select Type of Project
                    option(value='upcoming') Upcoming Projects
                    option(value='completed') Completed Projects
                
                .form-group
                  label.form-label Select Project
                  select.form-select#selectProject(disabled)
                    option(value='' disabled selected) Select Project

            // Section Selection Tabs
            .section-tabs
              button.tab-btn.active(data-section="hero-section") Project Intro
              button.tab-btn(data-section="features-grid") Key Features
              button.tab-btn(data-section="amenities-list") Amenities
              button.tab-btn(data-section="floor-image") Floor Plan
              button.tab-btn(data-section="location-container") Location
              button.tab-btn(data-section="gallery-wrapper") Gallery
              button.tab-btn(data-section="faq-items-container") FAQ

            // Dynamic Section Forms
            #detailsFormContainer(style="display: none;")
              // Hero Section Form
              form.section-form#form-hero-section.active(enctype="multipart/form-data" novalidate)
                .form-grid
                  .form-group.full-width
                    label
                      | Hero Title
                    input.form-input(type="text" name="title" placeholder="e.g. Sunset Ridge Residence")
                  .form-group.full-width
                    label
                      | Project Name
                    input.form-input(type="text" name="buiding_name" placeholder="e.g. Sunset Ridge" readonly)
                  .form-group
                    label
                      | Date
                    input.form-input(type="date" name="date" readonly)
                  .form-group
                    label
                      | Location
                    input.form-input(type="text" name="location" placeholder="e.g. Bhimavaram, Andhra Pradesh" readonly)
                button.submit-btn(type="submit") Save

              // Floor Image Form
              form.section-form#form-floor-image(enctype="multipart/form-data" novalidate)
                .form-grid
                  .form-group.full-width
                    label.form-label
                      | Floor Plan Title
                    input.form-input(type="text" name="title" placeholder="e.g. Floor Layout")
                  .form-group.full-width
                    label.form-label
                      | Floor Plan Image
                    div.upload-btn
                      .upload-icon
                        svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24', fill='currentColor')
                          path(d='M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71t-71 29ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H638l-73-80H395l-73 80H160v480Zm320-240Z')
                      p.upload-text Upload Image
                      p.upload-subtext JPG, PNG (max. 5MB)
                      input.image-upload(type='file' name='floorImage' accept='image/*' style='display: none;')
                button.submit-btn(type="submit") Save

              // Features Grid Form (List based)
              form.section-form#form-features-grid(novalidate)
                #featuresContainer
                button.add-more-btn(type="button" id="addFeatureBtn") + Add
                button.submit-btn(type="submit") Save

              // Amenities List Form
              form.section-form#form-amenities-list(novalidate)
                .form-group.full-width
                  label(style="font-weight: bold; margin-bottom: 5px; display: block;")
                    | Amenities Description (Header)
                textarea.form-textarea#amenitiesDescription(placeholder="e.g. Discover the stunning interiors..." rows="3" maxlength="200")
                .form-group.full-width
                  label(style="font-weight: bold; margin-bottom: 5px; display: block;")
                    | Amenities
                  .amenities-dropdown-container
                    .amenities-input-wrapper
                      input.amenities-search-input#amenitiesTagInput(type="text" placeholder="Search or select amenities...")
                      span.dropdown-arrow
                        svg(width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                          path(d='m6 9 6 6 6-6')
                    #amenitiesSuggestions.amenities-suggestions-list(style="display: none;")
                  .selected-amenities-list#amenitiesTags
                  input#amenitiesHiddenInput(type="hidden" name="amenities")
                button.submit-btn(type="submit") Save

              // Location Container Form
              form.section-form#form-location-container(enctype="multipart/form-data" novalidate)
                .form-grid
                  .form-group.full-width
                    label(style="font-weight: bold; margin-bottom: 5px; display: block;")
                      | Location Description (Header)
                    textarea.form-textarea#locationDescription(placeholder="e.g. Discover the exceptional amenities..." rows="3" maxlength="200")
                  .form-group.full-width
                    label.form-label
                      | Location Image (Map/Area)
                    div.upload-btn
                      .upload-icon
                        svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24', fill='currentColor')
                          path(d='M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71t-71 29ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H638l-73-80H395l-73 80H160v480Zm320-240Z')
                      p.upload-text Upload Image
                      p.upload-subtext JPG, PNG (max. 5MB)
                      input.image-upload(type='file' name='locationImage' accept='image/*' style='display: none;')
                  .form-group.full-width
                    label
                      | Address Text
                    input.form-input(type="text" name="address_text")
                  .form-group.full-width
                    label
                      | Connectivity Text
                    input.form-input(type="text" name="connectivity_text")
                
                h4(style="margin-top: 20px;") Landmarks
                #landmarksContainer
                button.add-more-btn(type="button" id="addLandmarkBtn") + Landmark
                
                button.submit-btn(type="submit" style="margin-top: 20px;") Save

              // Gallery Form
              form.section-form#form-gallery-wrapper(enctype="multipart/form-data" novalidate)
                .form-group.full-width
                  label(style="font-weight: bold; margin-bottom: 5px; display: block;")
                    | Gallery Description (Header)
                  textarea.form-textarea#galleryDescription(placeholder="e.g. Explore the stunning interiors..." rows="3" maxlength="200")
                
                .gallery-layout(style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;")
                  main.form-card-container#galleryCardContainer(style="padding: 24px; background: #fff; border: 1px solid #eee; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);")
                    .no-items-placeholder(style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px; color: #999;")
                      span.material-symbols-outlined(style="font-size: 48px; margin-bottom: 10px;") photo_library
                      p Select an item or click "Add Item" to begin.

                  section.added-items-section(style="border-top: 1px solid #eee; padding-top: 24px;")
                    div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;")
                      h3(style="font-size: 18px; color: var(--text-dark);") Gallery Items
                      button.add-more-btn(type="button" id="addGalleryBtn") + Add
                    
                    .added-items-list#gallerySidebarList(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;")
                
                button.submit-btn(type="submit" style="margin-top: 30px;") Save

              // FAQ Form
              form.section-form#form-faq-items-container(novalidate)
                #faqContainer
                button.add-more-btn(type="button" id="addFaqBtn") + Add FAQ
                button.submit-btn(type="submit") Save

        button.save-all-btn#saveAllBtn Save All

    script(src=utils.assetPath("/bundle/projectDetails.js"))