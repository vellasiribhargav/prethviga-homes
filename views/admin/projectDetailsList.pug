doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Project Details List
    link(rel='stylesheet' href=utils.assetPath("/bundle/projectDetailsList.css"))

  body
    - var activeLink = 'projectDetails'
    include ../layout/sidebar.pug
    
    // Main Page Content
    .main-container.with-sidebar
      // Top App Bar
      header.app-header
        .header-left
          button.menu-btn
            svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24')
              path(d='M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z')
          h1.page-title Project Details
      
      // Breadcrumbs
      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item Content Management
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item.active Project Details Management

      main.main-content
        .content-header(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;")
          h2.content-title Projects
          
          button#addBtn.add-more-btn(onclick="window.location.href='/admin/projectDetails/details'" style="display: flex; align-items: center; gap: 8px;")
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg')
              path(d='M6 12H18M12 6V18' stroke='#ffffffff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            | Manage Details

        .header-actions(style="display: flex; gap: 12px; align-items: center;")
            select#projectTypeFilter.filter-select
              option(value="all") All Projects
              option(value="upcoming") Upcoming
              option(value="completed") Completed
              
        .table-card
          .table-wrapper
            table.data-table
              thead
                tr
                  th S.NO.
                  th PROJECT NAME
                  th TYPE
                  th LOCATION
                  th ACTIONS
              tbody
                if projects && projects.length > 0
                   each project, idx in projects
                     tr(data-id=project.id data-type=project.type) 
                       td #{String(idx + 1).padStart(2, '0')}
                       td.item-name-cell #{project.project_name}
                       td #{project.type === 'upcoming' ? 'Upcoming' : 'Completed'}
                       td #{project.project_location}
                       td
                         .action-buttons
                            button.icon-action-btn.edit-btn(title="Manage Details" onclick=`window.location.href='/admin/projectDetails/details?projectId=${project.id}&type=${project.type}'`)
                               span.edit  
                                 svg(width='17' height='17' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' fill='currentColor')
                                   path(d='M3 17.25V21H6.75L17.81 9.94L14.06 6.19L3 17.25ZM20.71 7.04C21.1 6.65 21.1 6.02 20.71 5.63L18.37 3.29C17.98 2.9 17.35 2.9 16.96 3.29L15.13 5.12L18.88 8.87L20.71 7.04Z')
                else
                   tr
                     td(colspan="5" style="text-align:center; padding: 2rem;") No projects found.
          
          .table-footer
            .footer-info
              span Showing <span id="startRow">1</span> to <span id="endRow">#{projects ? projects.length : 0}</span> of <span id="totalRows">#{projects ? projects.length : 0}</span> projects
            .pagination
              button.page-btn.prev-page(disabled)
                svg(fill='#000000' height='24' width='24' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
                  path(d='M17.2 23.7 L5.4 12 L17.2 0.3 L18.5 1.7 L8.4 12 L18.5 22.3 Z')
              span.page-numbers
              button.page-btn.next-page
                svg(fill='#000000' height='24' width='24' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' xml:space='preserve')
                  path(d='M6.8 23.7 L5.4 22.3 L15.7 12 L5.4 1.7 L6.8 0.3 L18.5 12 Z')

    script(src=utils.assetPath("/bundle/projectDetailsList.js"))