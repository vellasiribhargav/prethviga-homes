doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title User Reviews Management
    link(rel='stylesheet' href=utils.assetPath("/bundle/reviews.css"))

  body
    - var activeLink = 'userReviews'
    
    include ../layout/sidebar.pug

    // Main Page Content
    .main-container.with-sidebar
      // Top App Bar
      header.app-header
        .header-left
          button.menu-btn
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='24' viewBox='0 -960 960 960' width='24' fill='#000')
              path(d='M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z')
          h1.page-title User Reviews Management

      // Breadcrumbs
      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item Content Management
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
            path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item.active User Reviews

      main.main-content
        // Content Header
        .content-header
          .header-title-group
            h2.content-title Manage Reviews
            p.content-subtitle Manage what your clients say about you on the home page.
          
          .header-actions
            button.back-btn(onclick="window.location.href='/admin/reviews/list'") List
            button#add-review-btn.add-more-btn Add Review
        
        // Form Container
        .form-container
          .content-card
            .form-section
              h3.section-subtitle Main Header
              .form-group.horizontal
                label.form-label Section Title
                input#review-title.form-input(type="text" placeholder="e.g., Loved by our clients")
            
            .form-divider
            
            h3.section-subtitle Reviews List
            #reviews-container
              // Reviews will be dynamically loaded here

            .submit-section
              button#save-all-btn.submit-btn Save Changes

    template#review-template
      .review-item
        button.remove-review(title="Remove Review")
          svg.icon(xmlns='http://www.w3.org/2000/svg' height='20' viewBox='0 -960 960 960' width='20' fill='currentColor')
            path(d='m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z')
        
        .review-grid
          .form-group.full-width
            label.form-label Review Text
            textarea.review-text.form-input.form-textarea(rows="2" placeholder="Enter the client's testimonial" maxlength="200")
            .char-limit-msg * Characters are more than 200
          
          .form-group
            label.form-label Client Name
            input.client-name.form-input(type="text" placeholder="Name")
          
          .form-group
            label.form-label Role
            input.client-role.form-input(type="text" placeholder="Role")
          
          .form-group
            label.form-label Footer / Project
            input.review-footer.form-input(type="text" placeholder="Project Name")

    script(src=utils.assetPath("/bundle/reviews.js"))