          .form-group 
            label(for="captcha") Captcha
            .captcha
              .captcha-container
                div#captcha-display(style="background: #f0f0f0; border-radius: 4px; padding: 10px; font-weight: bold; letter-spacing: 5px; font-size: 18px; user-select: none;")
