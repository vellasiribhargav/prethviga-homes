doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Admin Login | Prethviga Homes
    link(rel='stylesheet' href=utils.assetPath("/bundle/login.css"))
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet")

  body
    .login-wrapper
      .login-card
        .login-header
          span Prethviga Homes
          //- .logo-container
            img.logo(src="/assets/images/logo.png" alt="Prethviga Homes Logo")
          h1 Welcome Back
          p.subtitle Please enter your credentials to access the admin panel

        form.login-form(action="/admin/login" method="POST" autocomplete='off')
