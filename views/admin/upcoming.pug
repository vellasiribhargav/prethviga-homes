doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Upcoming Projects
    //- link(rel='stylesheet' href='/assets/admin_assests/fonts/manrope.css')
    //- link(rel='stylesheet' href='/assets/admin_assests/icons/icons.css')
    link(rel='stylesheet' href=utils.assetPath("/bundle/upcoming.css"))
  body
    - var activeLink = 'upcoming'
    include ../layout/sidebar.pug
    // Main Page Content
    .main-container.with-sidebar
      // Top App Bar
      header.app-header
        .header-left
          button.menu-btn
            svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24')
              path(d='M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z')
          h1.page-title Upcoming Projects
        button.notification-btn
          svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24')
            path(d='M160-200v-80h80v-280q0-83 50-147.5T420-792v-28q0-25 17.5-42.5T480-880q25 0 42.5 17.5T540-820v28q80 20 130 84.5T720-560v280h80v80H160Zm320-300Zm0 420q-33 0-56.5-23.5T400-160h160q0 33-23.5 56.5T480-80ZM320-280h320v-280q0-66-47-113t-113-47q-66 0-113 47t-47 113v280Z')
      // Breadcrumbs
      .breadcrumbs
        p.breadcrumb-text
          span.breadcrumb-item Prethviga Homes
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
              path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item Content Management
            svg.icon(xmlns='http://www.w3.org/2000/svg' height='12' viewBox='0 -960 960 960' width='12' fill='#000')
              path(d='M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z')
          span.breadcrumb-item.active Upcoming Projects
      main.main-content
        // Content Header
        .content-header
          h2.content-title Upcoming Projects
          button#addMoreBtn.add-more-btn  Add More
        // Form Container
        .form-container
          .content-card
            .form-header
              span.form-number 1
            .form-section
              // Image Upload
              .form-group
                label.form-label Project Image
                button.upload-btn
                  .upload-icon
                    svg.icon(xmlns='http://www.w3.org/2000/svg', height='24', viewBox='0 -960 960 960', width='24', fill='currentColor')
                      path(d='M480-260q75 0 127.5-52.5T660-440q0-75-52.5-127.5T480-620q-75 0-127.5 52.5T300-440q0 75 52.5 127.5T480-260Zm0-80q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71t-71 29ZM160-120q-33 0-56.5-23.5T80-200v-480q0-33 23.5-56.5T160-760h126l74-80h240l74 80h126q33 0 56.5 23.5T880-680v480q0 33-23.5 56.5T800-120H160Zm0-80h640v-480H638l-73-80H395l-73 80H160v480Zm320-240Z')
                  p.upload-text Tap to upload
                  p.upload-subtext SVG, PNG, JPG (max. 5MB)
                input(type='file' accept='image/*' style='display: none;')
              // Project Name
              .form-group
                label.form-label Project Name
                input.form-input(type='text' name='project-name' placeholder='e.g. New Office Tower Build')
              // Project Location
              .form-group.location-group
                label.form-label Project Location
                .input-wrapper
                  input.form-input(type='text' name='project-location' placeholder='e.g. Chicago, IL')
                  svg.icon.location-icon(xmlns='http://www.w3.org/2000/svg', height='20', viewBox='0 -960 960 960', width='20', fill='currentColor')
                    path(d='M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 294q122-112 181-203.5T720-552q0-109-69.5-178.5T480-800q-101 0-170.5 69.5T240-552q0 71 59 162.5T480-186Zm0 106Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Zm0-480Z')
              // Project Timeline
              .form-group
                label.form-label Project Timeline
                input.form-input(type='date' name='timeline-date')
              // Project Description
              .form-group
                label.form-label Project Description
                input.form-input(type='text' name='project-description' placeholder='Enter project description or notes...')
            // Submit Button
            .submit-section
              button.submit-btn Submit
            // Navigation buttons
            .navigation-buttons
              button.nav-btn.prev-btn(disabled='') Previous
              button.nav-btn.next-btn Next
        // Added Projects
        .added-items-section(style='display: none;')
          h3.section-title Added Projects
          .added-items-list
          
    //- script(src="/javascript/upcoming.js")
    script(src=utils.assetPath("/bundle/upcoming.js"))
